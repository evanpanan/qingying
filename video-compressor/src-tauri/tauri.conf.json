{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻影",
  "version": "1.10.1",
  "identifier": "com.lightvid.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-desktop-ai.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻影",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/yt-dlp",
      "binaries/node"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../NODE_LICENSE": "NODE_LICENSE",
      "../desktop-ai/": "desktop-ai/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMzA5MzUzQzZBQkY4Q0MKUldUTStLdkdVNU13dy9EL0ZXNXQvZ3k2WWRoeEhhMUZ6OEVFVG5WRG1TeG0zTzA5aWRPdzk2K3oK",
      "endpoints": [
        "https://github.com/evanpanan/qingying/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
